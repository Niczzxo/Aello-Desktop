[Desktop Entry]
Categories=AudioVideo;Video;Player;
Comment=The privacy-first desktop companion to Aello for Android.
Exec=flow %u
StartupWMClass=flow
Icon=io.github.niczzxo.Aello-Desktop
Name=Aello
Terminal=false
Type=Application
MimeType=x-scheme-handler/flow;
Actions=new-window;safe-graphics;

[Desktop Action safe-graphics]
Name=Start with safe graphics
Exec=flow --safe-graphics

[Desktop Action new-window]
Name=New window
Exec=flow --new-window
